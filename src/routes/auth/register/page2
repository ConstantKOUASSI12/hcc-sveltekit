<script lang="ts">
  import { goto } from '$app/navigation';
  import { authApi } from '$lib/api';

  let form = { first_name: '', last_name: '', email: '', contact: '', password: '', confirm: '' };
  let loading = false;
  let error   = '';
  let success = false;

  async function handleRegister() {
    if (Object.values(form).some(v => !v)) {
      error = 'Veuillez remplir tous les champs.'; return;
    }
    if (form.password !== form.confirm) {
      error = 'Les mots de passe ne correspondent pas.'; return;
    }
    if (form.password.length < 10) {
      error = 'Le mot de passe doit contenir au moins 10 caractères.'; return;
    }

    loading = true; error = '';

    try {
      const res = await authApi.register({
        first_name: form.first_name,
        last_name:  form.last_name,
        email:      form.email,
        contact:    form.contact,
        password:   form.password,
      });

      if (res.status === 201) {
        success = true;
      } else {
        error = res.message ?? 'Une erreur est survenue.';
      }
    } catch {
      error = 'Erreur de connexion au serveur.';
    } finally {
      loading = false;
    }
  }
</script>

<div class="min-h-screen bg-gray-50 flex items-center justify-center p-8">
  <div class="w-full max-w-lg animate-fade">

    <!-- Logo -->
    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 bg-gradient-hcc rounded-xl flex items-center justify-center">
        <span class="font-display text-white text-xl">H</span>
      </div>
      <div class="font-display text-hcc-600 text-2xl tracking-wide">HCC</div>
    </div>

    {#if success}
      <!-- Success state -->
      <div class="card text-center py-12">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h2 class="font-display text-3xl text-gray-900 tracking-wide mb-2">DEMANDE ENVOYÉE</h2>
        <p class="text-gray-500 text-sm max-w-sm mx-auto">
          Votre compte a été créé. Un administrateur du club va valider votre adhésion et vous assigner un rôle.
        </p>
        <a href="/auth/login" class="btn-primary mt-6 mx-auto w-fit">
          Retour à la connexion
        </a>
      </div>

    {:else}
      <div class="mb-8">
        <h1 class="font-display text-4xl text-gray-900 tracking-wide">INSCRIPTION</h1>
        <p class="text-gray-400 text-sm mt-1">Rejoignez le Handball Club de Comines</p>
      </div>

      {#if error}
        <div class="bg-red-50 border border-red-200 text-red-600 rounded-xl px-4 py-3 text-sm mb-6">
          {error}
        </div>
      {/if}

      <div class="card">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label" for="first_name">Prénom</label>
            <input id="first_name" type="text" class="input" placeholder="Alice"
                   bind:value={form.first_name} disabled={loading}/>
          </div>
          <div>
            <label class="label" for="last_name">Nom</label>
            <input id="last_name" type="text" class="input" placeholder="Dupont"
                   bind:value={form.last_name} disabled={loading}/>
          </div>
        </div>

        <div class="mt-4">
          <label class="label" for="email">Email</label>
          <input id="email" type="email" class="input" placeholder="alice@email.com"
                 bind:value={form.email} disabled={loading}/>
        </div>

        <div class="mt-4">
          <label class="label" for="contact">Contact (téléphone)</label>
          <input id="contact" type="tel" class="input" placeholder="0600000000"
                 bind:value={form.contact} disabled={loading}/>
        </div>

        <div class="mt-4">
          <label class="label" for="password">Mot de passe</label>
          <input id="password" type="password" class="input" placeholder="Min. 10 caractères"
                 bind:value={form.password} disabled={loading}/>
        </div>

        <div class="mt-4">
          <label class="label" for="confirm">Confirmer le mot de passe</label>
          <input id="confirm" type="password" class="input" placeholder="••••••••••••"
                 bind:value={form.confirm} disabled={loading}/>
        </div>

        <button on:click={handleRegister} disabled={loading}
                class="btn-primary w-full justify-center py-3 mt-6">
          {#if loading}
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            Inscription...
          {:else}
            Créer mon compte
          {/if}
        </button>
      </div>

      <p class="text-center text-sm text-gray-400 mt-4">
        Déjà membre ?
        <a href="/auth/login" class="text-hcc-600 font-medium hover:underline">Se connecter</a>
      </p>
    {/if}
  </div>
</div>
